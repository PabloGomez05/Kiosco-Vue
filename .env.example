# =============================================================================
# Configuración de Entorno - Sistema de Gestión e Inventario para Kiosco
# Copiar este archivo como .env y completar con las credenciales locales:
#   cp .env.example .env
# =============================================================================

# Servidor Backend (Node.js + Express)
PORT=3000
NODE_ENV=development

# Base de Datos MySQL 8.0 (InnoDB / utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=kiosk_db

# Seguridad y Autenticación JWT
JWT_SECRET=reemplazar_por_una_clave_secreta_larga_y_segura_2026
JWT_EXPIRES_IN=1h

